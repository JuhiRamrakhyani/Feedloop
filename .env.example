# App name shown in the UI and message titles.
APP_NAME=FeedLoop

PORT=3000
# Public URL the feedback link uses. Use a public URL for real sends;
# http://localhost:3000 is fine for local testing.
PUBLIC_BASE_URL=http://localhost:3000

# PostgreSQL - the app's only database (identities + templates + requests + answers)
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=postgres
PG_DATABASE=feedloop

# Link tokens - change LINK_SECRET in production
LINK_SECRET=change-this-to-a-long-random-string-in-production
LINK_EXPIRY=14d
LINK_TOKEN_BYTES=12

# ---------------------------------------------------------------------------
# Delivery — how feedback links are sent to recipients.
#   log     : print to the server console (default, zero setup)
#   webhook : POST JSON to WEBHOOK_URL (works with WAHA, Evolution API, a
#             Baileys microservice, Twilio, Zapier, n8n, anything HTTP)
#   baileys : free open-source WhatsApp Web client. Run `npm run whatsapp:login`
#             once to scan a QR, then set DELIVERY_PROVIDER=baileys
# ---------------------------------------------------------------------------
DELIVERY_PROVIDER=log

# webhook provider
WEBHOOK_URL=
WEBHOOK_TOKEN=
WEBHOOK_TIMEOUT=15000

# baileys provider
BAILEYS_AUTH_DIR=.baileys_auth
BAILEYS_CONNECT_TIMEOUT=60000
WHATSAPP_COUNTRY_CODE=91

# Optional URL shortener — off by default so links open directly.
# tinyurl | isgd | off
URL_SHORTENER=off
URL_SHORTENER_TIMEOUT=5000
